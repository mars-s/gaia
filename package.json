{
  "name": "gaia",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch apps/server/main.ts\" \"vite --host 127.0.0.1\"",
    "start": "tsx apps/server/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test apps/server/*.test.ts apps/web/*.test.ts apps/desktop/*.test.ts core/*.test.ts scripts/owner-upgrade/*.test.ts",
    "test:experiences": "tsx --test apps/server/experience-*.test.ts apps/web/experience-*.test.ts",
    "test:owner-upgrade": "tsx --test scripts/owner-upgrade/*.test.ts",
    "owner-upgrade": "tsx scripts/owner-upgrade/cli.ts",
    "build": "tsc --noEmit && vite build && npm run build:desktop",
    "typecheck:desktop": "tsc --project apps/desktop/tsconfig.json --noEmit",
    "build:desktop": "tsc --project apps/desktop/tsconfig.json",
    "desktop": "npm run build:desktop && node apps/desktop/launch.mjs",
    "start:managed": "tsx core/main.ts",
    "check:protocol": "tsx core/conformance.ts"
  },
  "dependencies": {
    "@assistant-ui/core": "0.3.32",
    "@assistant-ui/store": "0.3.22",
    "@assistant-ui/tap": "0.9.24",
    "@base-ui/react": "1.9.0",
    "@earendil-works/chord": "^1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/postcss": "^4.3.4",
    "axe-core": "4.14.0",
    "react": "^19.2.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "unified": "11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.0",
    "electron": "45.2.2",
    "eslint": "^10.14.0",
    "fake-indexeddb": "6.2.7",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.2.0"
  }
}
