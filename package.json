{
  "name": "gaia",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch apps/server/main.ts\" \"vite --host 127.0.0.1\"",
    "start": "tsx apps/server/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test apps/server/*.test.ts",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/postcss": "^4.3.4",
    "react": "^19.2.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.2.0"
  }
}
